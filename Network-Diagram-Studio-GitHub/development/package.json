{
  "name": "network-diagram-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode public",
    "build": "node scripts/release.mjs build",
    "build:public": "npm run build",
    "typecheck": "tsc -b",
    "check:release": "node scripts/check-release-history.mjs",
    "release:seal": "node scripts/check-release-history.mjs --seal",
    "release:verify": "node scripts/release.mjs verify",
    "release:publish": "node scripts/release.mjs publish",
    "test": "npm run release:verify",
    "test:updates": "node test-release-history.cjs && node test-updates.cjs",
    "test:all-icons-layout": "node test-all-icons-layout.cjs",
    "test:settings-bounds": "node test-settings-bounds.cjs",
    "test:group-header-fields": "node test-group-header-fields.cjs",
    "test:shape-text-format": "node test-shape-text-format.cjs",
    "test:database-shape": "node test-database-shape.cjs",
    "test:shape-connector-selection": "node test-shape-connector-selection.cjs",
    "test:object-selection": "node test-object-selection.cjs",
    "test:public": "node test-public-build.cjs",
    "test:release": "node test-release-history.cjs && node test-release-workflow.cjs",
    "test:imported-icons": "node test-imported-icons.cjs",
    "test:library-recovery": "node test-imported-icons.cjs --transfers",
    "test:library-delete": "node test-imported-icons.cjs --deletion",
    "test:placement-feedback": "node test-placement-feedback.cjs",
    "test:tab-order": "node test-tab-order.cjs",
    "test:demo-video": "node test-demo-video.cjs",
    "test:imported-resource-drag": "node test-imported-resource-drag.cjs",
    "test:imported-connector-selection": "node test-imported-connector-selection.cjs",
    "test:resource-selection": "node test-resource-selection.cjs",
    "test:screenshot-shapes": "node test-screenshot-shapes.cjs",
    "test:canvas-motion": "node test-canvas-motion.cjs",
    "test:canvas-chrome": "node test-canvas-chrome.cjs",
    "build:icons": "node scripts/build-icon-sprite.mjs",
    "lint": "oxlint src scripts vite.config.ts"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "1.62.0-alpha-2026-07-22",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
